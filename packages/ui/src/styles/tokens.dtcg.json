{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Calm, trustworthy and modern operating-system UI for PAYSAVE Recovery staff, partners, supervisors and field agents.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.039, 0.4, 0.761],
        "hex": "#0a66c2"
      }
    },
    "primary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.035, 0.345, 0.659],
        "hex": "#0958a8"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.063, 0.451, 0.31],
        "hex": "#10734f"
      }
    },
    "secondary-hover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.043, 0.373, 0.255],
        "hex": "#0b5f41"
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.957, 0.969, 0.984],
        "hex": "#f4f7fb"
      }
