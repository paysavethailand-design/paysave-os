        "colorSpace": "srgb",
        "components": [0.09, 0.361, 0.827],
        "hex": "#175cd3"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "2xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "3xl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "4xl": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "2xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "-apple-system, BlinkMacSystemFont, SF Pro Display, IBM Plex Sans Thai, Noto Sans Thai, sans-serif",
        "fontSize": {
          "value": 3,
          "unit": "rem"
