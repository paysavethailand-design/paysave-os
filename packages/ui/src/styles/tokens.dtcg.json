    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.863, 0.894, 0.933],
        "hex": "#dce4ee"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.706, 0.137, 0.094],
        "hex": "#b42318"
      }
