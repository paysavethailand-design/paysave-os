NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
PAYSAVE_ENABLE_DESIGN_PREVIEW=false
# 32 raw bytes, base64-encoded (e.g. `openssl rand -base64 32`). Never reuse this placeholder.
PAYSAVE_FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PAYSAVE_FIELD_ENCRYPTION_KEY_VERSION=1
# Production identity and fail-closed access gate
PAYSAVE_ENVIRONMENT=development
PAYSAVE_PRODUCTION_ACCESS_ALLOWED=false
PAYSAVE_RELEASE_VERSION=0.1.0-dev
PAYSAVE_SOURCE_REVISION=0000000000000000000000000000000000000000
PAYSAVE_BUILD_TIME=1970-01-01T00:00:00Z
PAYSAVE_CANONICAL_DOMAIN=localhost
PAYSAVE_TLS_MIN_VERSION=1.2
# Secret Manager references identify provider-owned secrets; values are injected separately.
PAYSAVE_FIELD_ENCRYPTION_KEY_REF=secret://replace-me/field-encryption
PAYSAVE_LINE_CHANNEL_ID=replace_me
PAYSAVE_LINE_CHANNEL_ACCESS_TOKEN=replace_me_at_runtime
PAYSAVE_LINE_CHANNEL_ACCESS_TOKEN_REF=secret://replace-me/line-channel-access-token
PAYSAVE_EMAIL_PROVIDER=resend
PAYSAVE_EMAIL_FROM=noreply@example.invalid
PAYSAVE_EMAIL_API_KEY=replace_me_at_runtime
PAYSAVE_EMAIL_API_KEY_REF=secret://replace-me/email-api-key
PAYSAVE_GOOGLE_DRIVE_FOLDER_ID=replace_me
PAYSAVE_GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}
PAYSAVE_GOOGLE_SERVICE_ACCOUNT_JSON_REF=secret://replace-me/google-service-account
PAYSAVE_WEBHOOK_SIGNING_SECRET=replace_me_at_runtime
PAYSAVE_WEBHOOK_SIGNING_SECRET_REF=secret://replace-me/webhook-signing
PAYSAVE_EXTERNAL_API_ALLOWLIST=https://api.line.me,https://www.googleapis.com
PAYSAVE_MONITORING_DSN=https://public@example.invalid/1
PAYSAVE_MONITORING_DSN_REF=secret://replace-me/monitoring-dsn
