# PAYSAVE Production Environment Variables
# 
# This file is a template for production deployments.
# All values are placeholders only. Never commit real secrets.
#
# For production, prefer Secret Manager references (see *_REF variables)
# where supported by the platform (Hostinger, etc.).
#
# Required for production runtime validation.

# Application URLs (must be HTTPS, non-local, distinct hosts)
NEXT_PUBLIC_APP_URL=https://paysave.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Design preview must be disabled in production
PAYSAVE_ENABLE_DESIGN_PREVIEW=false

# Production environment and access gate
PAYSAVE_ENVIRONMENT=production
PAYSAVE_PRODUCTION_ACCESS_ALLOWED=true

# Canonical domain and TLS
PAYSAVE_CANONICAL_DOMAIN=paysave.example.com
PAYSAVE_TLS_MIN_VERSION=1.3

# Release identity (updated at build time in real deployments)
PAYSAVE_RELEASE_VERSION=1.0.0
PAYSAVE_SOURCE_REVISION=0000000000000000000000000000000000000000
PAYSAVE_BUILD_TIME=2026-01-01T00:00:00Z

# Field encryption (32-byte base64 key)
# In production, use the REF variant and inject via secrets.
PAYSAVE_FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PAYSAVE_FIELD_ENCRYPTION_KEY_VERSION=1
PAYSAVE_FIELD_ENCRYPTION_KEY_REF=secret://replace-me/field-encryption-key

# LINE integration
PAYSAVE_LINE_CHANNEL_ID=your_line_channel_id
PAYSAVE_LINE_CHANNEL_ACCESS_TOKEN=replace_at_runtime
PAYSAVE_LINE_CHANNEL_ACCESS_TOKEN_REF=secret://replace-me/line-channel-access-token

# Email provider (example: resend)
PAYSAVE_EMAIL_PROVIDER=resend
PAYSAVE_EMAIL_FROM=noreply@paysave.example.com
PAYSAVE_EMAIL_API_KEY=replace_at_runtime
PAYSAVE_EMAIL_API_KEY_REF=secret://replace-me/email-api-key

# Google Drive / Service Account
PAYSAVE_GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
PAYSAVE_GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-gcp-project"}
PAYSAVE_GOOGLE_SERVICE_ACCOUNT_JSON_REF=secret://replace-me/google-service-account

# Webhook signing
PAYSAVE_WEBHOOK_SIGNING_SECRET=replace_at_runtime
PAYSAVE_WEBHOOK_SIGNING_SECRET_REF=secret://replace-me/webhook-signing-secret

# External API allowlist (comma-separated HTTPS origins only)
PAYSAVE_EXTERNAL_API_ALLOWLIST=https://api.line.me,https://www.googleapis.com

# Monitoring (Sentry DSN example)
PAYSAVE_MONITORING_DSN=https://yourkey@yourorg.ingest.sentry.io/project
PAYSAVE_MONITORING_DSN_REF=secret://replace-me/monitoring-dsn

# Database URL (optional - only for transactional recovery profiles)
# Leave unset if using Supabase-only paths.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_URL=secret://replace-me/database-url

# End of .env.production.example
# Copy to .env or inject via platform environment configuration for production.

# Sprint 11E Production Supabase wiring
NODE_ENV=production
USE_MOCK=false
# Supabase live connection (must be set in actual production env)
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=...

